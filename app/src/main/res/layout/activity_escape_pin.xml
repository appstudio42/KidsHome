<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/escapePinRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="480dp"
            android:padding="@dimen/space_md">

            <LinearLayout
                android:id="@+id/pinCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/space_sm"
                android:background="@drawable/bg_pin_card"
                android:gravity="center_horizontal"
                android:maxWidth="@dimen/pin_card_max_width"
                android:orientation="vertical"
                android:padding="@dimen/pin_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.KidsHome.Display"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/escapeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:labelFor="@+id/escapePinInput"
                    android:text="@string/escape_pin_message"
                    android:textAppearance="@style/TextAppearance.KidsHome.Body"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:id="@+id/pinDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:contentDescription="@string/cd_pin_dots"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <EditText
                    android:id="@+id/escapePinInput"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:importantForAutofill="no"
                    android:inputType="numberPassword"
                    android:maxLength="8"
                    android:visibility="invisible" />

                <include
                    android:id="@+id/pinKeypad"
                    layout="@layout/view_pin_keypad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/escapeSubmit"
                    android:layout_width="@dimen/pin_unlock_max_width"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/unlock"
                    app:cornerRadius="@dimen/corner_md" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/escapeCancel"
                    style="@style/Widget.KidsHome.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/back_to_kid_app" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
