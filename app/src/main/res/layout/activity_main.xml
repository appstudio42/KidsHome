<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mainToolbar"
        style="@style/Widget.KidsHome.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="@string/app_name"
        app:titleTextColor="?attr/colorOnPrimary" />

    <TextView
        android:id="@+id/statusBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bannerBackground"
        android:minHeight="@dimen/touch_min"
        android:padding="@dimen/space_md"
        android:textColor="@color/bannerText"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Status banner"
        tools:visibility="visible" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/parent_hub_subtitle"
                android:textAppearance="@style/TextAppearance.KidsHome.Body"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <include
                android:id="@+id/cardChild"
                layout="@layout/item_hub_card" />

            <include
                android:id="@+id/cardApps"
                layout="@layout/item_hub_card" />

            <include
                android:id="@+id/cardWeb"
                layout="@layout/item_hub_card" />

            <include
                android:id="@+id/cardTime"
                layout="@layout/item_hub_card" />

            <include
                android:id="@+id/cardSchedules"
                layout="@layout/item_hub_card" />

            <include
                android:id="@+id/cardAppLimits"
                layout="@layout/item_hub_card" />

            <include
                android:id="@+id/cardEarn"
                layout="@layout/item_hub_card" />

            <include
                android:id="@+id/cardReport"
                layout="@layout/item_hub_card" />

            <include
                android:id="@+id/cardDevice"
                layout="@layout/item_hub_card" />

            <include
                android:id="@+id/cardSecurity"
                layout="@layout/item_hub_card" />

            <include
                android:id="@+id/cardAbout"
                layout="@layout/item_hub_card" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/launcherSection"
                style="@style/Widget.KidsHome.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/main_subtitle"
                        android:textAppearance="@style/TextAppearance.KidsHome.Section" />

                    <ListView
                        android:id="@+id/lvApps"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="@dimen/space_sm"
                        android:choiceMode="singleChoice"
                        android:nestedScrollingEnabled="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
