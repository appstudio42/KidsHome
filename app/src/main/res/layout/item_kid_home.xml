<?xml version="1.0" encoding="utf-8"?>
<io.github.marcelsavegnago.kidshome.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    tools:layout_width="140dp"
    tools:layout_height="140dp">

    <LinearLayout
        android:id="@+id/kidTileInner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_kid_tile"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm">

        <ImageView
            android:id="@+id/kidIcon"
            android:layout_width="@dimen/kid_icon_size"
            android:layout_height="@dimen/kid_icon_size"
            android:layout_marginBottom="2dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/kidLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/kid_tile_label"
            android:textSize="@dimen/kid_label_text"
            android:textStyle="bold"
            tools:text="Photos" />
    </LinearLayout>
</io.github.marcelsavegnago.kidshome.SquareFrameLayout>
