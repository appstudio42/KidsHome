<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/kidModeToolbar"
        style="@style/Widget.KidsHome.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/kid_mode" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/limitsNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bannerBackground"
                android:padding="@dimen/space_md"
                android:text="@string/kid_mode_limits"
                android:textColor="@color/bannerText"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openSetupButton"
                style="@style/Widget.KidsHome.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:minHeight="@dimen/touch_min"
                android:text="@string/setup_title" />

            <!-- Child profile -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.KidsHome.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/section_child_profile"
                        android:textAppearance="@style/TextAppearance.KidsHome.Section" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/kid_mode_enable"
                            android:textSize="16sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/kidModeSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_min" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:hint="@string/child_name_hint"
                        app:boxBackgroundMode="outline">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/childNameInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/childAvatarPreview"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_avatar_circle"
                            android:gravity="center"
                            android:text="🙂"
                            android:textSize="24sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pickAvatarButton"
                            style="@style/Widget.KidsHome.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:minHeight="@dimen/touch_min"
                            android:text="@string/pick_avatar" />
                    </LinearLayout>

                    <RadioGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm">

                        <RadioButton
                            android:id="@+id/lockKidHome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_min"
                            android:text="@string/lock_to_kid_home" />

                        <RadioButton
                            android:id="@+id/lockApp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_min"
                            android:text="@string/lock_to_app" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/kidAppLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/kid_app_none" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pickAppButton"
                        style="@style/Widget.KidsHome.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/pick_kid_app" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Allowed apps / websites -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.KidsHome.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/section_allowed_content"
                        android:textAppearance="@style/TextAppearance.KidsHome.Section" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/manageAllowedApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/manage_allowed_apps" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/manageSites"
                        style="@style/Widget.KidsHome.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/manage_site_shortcuts" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pickBrowser"
                        style="@style/Widget.KidsHome.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/pick_browser" />

                    <TextView
                        android:id="@+id/browserLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/browser_default" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Screen time -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/screenTimeCard"
                style="@style/Widget.KidsHome.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_time_section"
                        android:textAppearance="@style/TextAppearance.KidsHome.Section" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/screenTimeEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/screen_time_enable" />

                    <TextView
                        android:id="@+id/dailyLimitLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/daily_limit_slider_fmt" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/dailyLimitSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="15"
                        android:valueFrom="15"
                        android:valueTo="240"
                        app:haloRadius="0dp" />

                    <!-- Kept for logic compatibility; driven by the slider. -->
                    <EditText
                        android:id="@+id/dailyLimitInput"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:importantForAccessibility="no"
                        android:inputType="number"
                        android:visibility="gone" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/bedtimeEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/bedtime_enable" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bedtimeStartButton"
                            style="@style/Widget.KidsHome.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_min"
                            android:text="@string/bedtime_start" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bedtimeEndButton"
                            style="@style/Widget.KidsHome.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_min"
                            android:text="@string/bedtime_end" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Security / escape -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.KidsHome.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/section_security"
                        android:textAppearance="@style/TextAppearance.KidsHome.Section" />

                    <TextView
                        android:id="@+id/escapeHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="@color/md_primary_container"
                        android:padding="@dimen/space_md"
                        android:text="@string/kid_mode_escape_help"
                        android:textColor="@color/md_on_primary_container"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/escape_options_title"
                        android:textStyle="bold" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/escapeCornerCB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/escape_option_corner" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/escapeBackHoldCB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/escape_option_back_hold" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/touchSoundsCB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/touch_sounds_optional" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changePinButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/change_pin" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_lg"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelKidModeButton"
                    style="@style/Widget.KidsHome.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveKidModeButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/save" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
