<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <TextView
        android:id="@+id/limitDialogValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.KidsHome.Title"
        android:text="@string/app_time_unlimited" />

    <com.google.android.material.slider.Slider
        android:id="@+id/limitDialogSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:valueFrom="0"
        android:valueTo="120"
        android:stepSize="5"
        android:value="30" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/limitDialogPresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        app:singleSelection="true"
        app:selectionRequired="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/preset15"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_limit_preset_15" />

        <com.google.android.material.chip.Chip
            android:id="@+id/preset30"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_limit_preset_30" />

        <com.google.android.material.chip.Chip
            android:id="@+id/preset60"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_limit_preset_60" />

        <com.google.android.material.chip.Chip
            android:id="@+id/presetUnlimited"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_limit_unlimited" />
    </com.google.android.material.chip.ChipGroup>
</LinearLayout>
