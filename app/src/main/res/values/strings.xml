    <string name="about_title">About KidsHome</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_body">KidsHome is a GPL-3 kid-mode home for Android phones/tablets and Amazon Fire OS.\n\nIt can run as an accessibility Home hijack (Fire), a real default launcher, or Device Owner lock-task kiosk.\n\nBased on LauncherHijack by BaronKiko and Launcher Replacer by Meems33 / WhiteRaven777.</string>
