<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy full-backup rules (API 23+). Every domain is excluded so a backup
    cannot copy the PIN hash, the legacy PIN salt, or the remote token.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
